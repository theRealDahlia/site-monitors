[Unit]
Description=Site Monitors
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/site-monitors
Environment=NODE_ENV=production
# Caddy is the one that faces the internet, and the firewall must keep port 3000 closed (only 22, 80 and 443 open).
# Don't add "-H 127.0.0.1" to keep the app on this machine only: with it, every NextResponse.rewrite in proxy.ts fails
# with a 500 behind Caddy, because Next then compares the rewrite against 127.0.0.1 and sees an outside address.
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
