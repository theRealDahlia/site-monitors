# Required in production. Signs the cookie that tracks each visitor's free checks.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# How many proxies sit in front of the app (Vercel, Fly or Cloudflare on their own = 1).
# Used to read the visitor's real IP from x-forwarded-for.
TRUSTED_PROXY_HOPS=1

# Public address of the site (no trailing slash). Used for links in alert emails. Required in production.
APP_URL=https://site-monitors.net

# Email sending via Resend (https://resend.com). MAIL_FROM must be on a domain you've verified there.
# Without these, development prints emails to the server console and data/outbox.log instead.
RESEND_API_KEY=
MAIL_FROM="Site Monitors <hello@yourdomain.com>"

# Slack and Discord sign-in, so users can connect a channel without making their own app. Each comes
# from the app you create on api.slack.com/apps and discord.com/developers/applications (see
# deploy/README.md). Until both values for a service are set, its Connect button says "Not set up yet".
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord also needs the bot's token (Bot tab → Reset Token). Without it, Discord shows "Not set up yet".
DISCORD_BOT_TOKEN=

# Visitor analytics on the public pages, from a cookieless service. Leave empty to turn it off.
# Plausible: ANALYTICS_PROVIDER=plausible, ANALYTICS_ID=site-monitors.net
# Umami:     ANALYTICS_PROVIDER=umami,     ANALYTICS_ID=<website id>  (ANALYTICS_SRC for a self-hosted script address)
ANALYTICS_PROVIDER=
ANALYTICS_ID=
ANALYTICS_SRC=

# Where emails about errors go. Defaults to the support address.
ERROR_ALERT_EMAIL=
